DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
STORAGE_DIR="./storage/uploads"
MAX_FILE_SIZE_MB="50"

# SMTP Email Verification Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SecureShare Vault <no-reply@secureshare.local>"
APP_BASE_URL="http://localhost:3000"
# Secret used to sign short-lived access cookies for password-protected public shares
SHARE_ACCESS_SECRET=
